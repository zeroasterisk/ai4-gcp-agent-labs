# Copy this file to .env and replace the placeholders with your own values:
#   cp .env.example .env
# The lab loads .env automatically (this lab's first, then the repo root's).
# REAL environment variables always win over .env.
# Placeholders like `your-project-id` are treated as "not set", so an
# unedited copy fails fast with instructions instead of a confusing 403.
#
# ===========================================================================
# PATH A (DEFAULT) - Vertex AI + Application Default Credentials
#   gcloud auth application-default login
# GOOGLE_GENAI_USE_ENTERPRISE replaces the deprecated GOOGLE_GENAI_USE_VERTEXAI.
# ===========================================================================
GOOGLE_GENAI_USE_ENTERPRISE=True
GOOGLE_CLOUD_PROJECT=your-project-id
# Where the MODEL is served from. `global` is the most broadly available
# Gemini endpoint, which is why it is the default. A region such as
# us-central1 also works but carries fewer models.
GOOGLE_CLOUD_LOCATION=global

# ===========================================================================
# PATH B (FALLBACK) - AI Studio API key. No GCP project, no billing, no gcloud.
# Lab 01 runs fully on this path. Labs 02-04 need a real GCP project.
# Get a key at https://aistudio.google.com/apikey, then comment out PATH A
# above and uncomment these two lines.
# ===========================================================================
# GOOGLE_GENAI_USE_ENTERPRISE=False
# GOOGLE_API_KEY=your-api-key

# Optional. The default model is gemini-flash-latest. No model is available in
# every project and region - GEMINI_MODEL is the escape hatch. Leave commented
# to use the default; `python check_prereqs.py --probe-models` finds one that
# works for you.
# GEMINI_MODEL=gemini-2.5-flash
