# Copy this file to .env and replace the placeholders with your own values:
#   cp .env.example .env
# The lab loads .env automatically (this lab's first, then the repo root's).
# REAL environment variables always win over .env.
# Placeholders like `your-project-id` are treated as "not set", so an
# unedited copy fails fast with instructions instead of a confusing 403.
#
# ===========================================================================
# PATH A (DEFAULT) - Vertex AI + Application Default Credentials
#   gcloud auth application-default login
# GOOGLE_GENAI_USE_ENTERPRISE replaces the deprecated GOOGLE_GENAI_USE_VERTEXAI.
# ===========================================================================
GOOGLE_GENAI_USE_ENTERPRISE=True
GOOGLE_CLOUD_PROJECT=your-project-id
# Where the MODEL is served from. `global` is the most broadly available
# Gemini endpoint, which is why it is the default.
GOOGLE_CLOUD_LOCATION=global
# Where MANAGED RESOURCES live (Agent Engine / Agent Runtime, and the Skill
# and Agent registries). These are regional and do NOT accept `global`, so
# they use the Agent Platform SDK's own variable. If you leave this unset it
# falls back to GOOGLE_CLOUD_LOCATION when that is a real region, else
# us-central1.
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1

# ===========================================================================
# PATH B (FALLBACK) - AI Studio API key: NOT ENOUGH FOR THIS LAB.
# This lab deploys to Agent Engine / Agent Runtime, so it needs PATH A above.
# Only Lab 01 runs on an API key alone.
# ===========================================================================
# GOOGLE_API_KEY=your-api-key

# --- Lab 04 specifics -------------------------------------------------------
REGISTRY_LOCATION=global
OPS_MCP_DISPLAY_NAME=cymbal-ops-mcp
# Optional staging bucket for the deploy, created by labs/terraform. Leave
# commented to default to gs://<your-project>-nimbus-agents.
# STAGING_BUCKET=gs://your-staging-bucket

# Optional. The default model is gemini-flash-latest. No model is available in
# every project and region - GEMINI_MODEL is the escape hatch. Leave commented
# to use the default; `python check_prereqs.py --probe-models` finds one that
# works for you.
# GEMINI_MODEL=gemini-2.5-flash
